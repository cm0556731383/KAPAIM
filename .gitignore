# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
.zed/
.nova/
.cursor/
.codex

# Laravel application
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/app/private/livewire-tmp/*

# Build-plan 18 — per-run reports from `php artisan legacy:import`; the
# sample fixture (storage/app/legacy-import-sample.csv) stays tracked.
/storage/app/legacy-import-reports/*
/bootstrap/cache/*.php
*.log
.phpactor.json
.phpunit.result.cache
.phpunit.cache
_ide_helper.php
/auth.json
Homestead.json
Homestead.yaml

.env
.env.*
!.env.example

# Backups produced by backup-database.sh, and manual SQL dumps of real data —
# never committed (only the folder's .gitkeep is tracked).
/backups/*
!/backups/.gitkeep

# Runtime files holding real business data: uploaded supplier invoices,
# material attachments, school logos, Livewire temp uploads, compiled views.
/storage/app/private/
/storage/app/public/
/storage/framework/views_v2/

# Local QA scratch (screenshots of real pages, ad-hoc scripts, minted sessions).
/storage/qa/

# Duplicate of assets/logo/kapaim-logo.gif left at the repo root (same md5) —
# kept on disk but not tracked twice.
/חסי-כפיים-004.gif
