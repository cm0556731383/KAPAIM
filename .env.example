# install.sh copies this to .env and fills in APP_KEY, DB_PASSWORD,
# APP_UID/APP_GID and APP_URL. Everything else can stay as is.

APP_NAME="כפיים"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address users open, e.g. https://crm.example.co.il — signed links in
# emails (document signing, supplier invoice upload) are built from it.
APP_URL=http://localhost:8090

APP_TIMEZONE=Asia/Jerusalem
APP_LOCALE=he
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=he_IL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ----- Docker (docker-compose.yml) -----
# The app answers on 127.0.0.1:APP_PORT only — put a reverse proxy with
# HTTPS in front of it (DEPLOY.md).
APP_PORT=8090
# The user that owns the project folder on the server (`id -u` / `id -g`).
APP_UID=1001
APP_GID=1001
# Container names: {prefix}_app, {prefix}_postgres, ...
CONTAINER_PREFIX=crm

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kapaim
DB_USERNAME=kapaim
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=kapaim_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Every outgoing email goes through Smove (set up on the settings page) —
# Laravel's own mailer is never used.
MAIL_MAILER=log
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
